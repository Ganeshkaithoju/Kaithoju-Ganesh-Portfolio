# WhatsApp Cloud API Integration Configuration
# Add these to your .env.local file

# Google Apps Script Deployment URL
# Get this after deploying the GOOGLE_APPS_SCRIPT_TEMPLATE.js
# Format: https://script.google.com/macros/s/{SCRIPT_ID}/usweb
VITE_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/useweb

# Alternative: If using direct fetch to Facebook API (not via Google Apps Script)
# Uncomment these lines and set your values
# VITE_WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# VITE_WHATSAPP_ACCESS_TOKEN=your_access_token

# Your WhatsApp Business Account Phone Number (used in messages)
# Format: without +91 prefix (e.g., 7075409339)
VITE_WHATSAPP_OWNER_PHONE=7075409339
