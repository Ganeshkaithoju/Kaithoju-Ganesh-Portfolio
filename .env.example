# Supabase (already configured in your project)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Supabase Service Role Key (required for server-side operations)
# Get this from: Supabase Dashboard → Project Settings → API → Service Role Key
SUPABASE_URL=your_supabase_url
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Owner Authentication (for /owner-dashboard)
# Note: After running migration, password should be removed from here
# It will be stored encrypted in database instead
OWNER_EMAIL=your_email@example.com

# Security Questions for Password Reset (for /owner-forgot-password)
# Q1: What is your dream car?
SECURITY_ANSWER_1=your_answer_1
# Q2: What is your first mobile name?
SECURITY_ANSWER_2=your_answer_2

# Google Apps Script (optional, for WhatsApp notifications)
VITE_GOOGLE_APPS_SCRIPT_URL=your_gas_deployment_url

# Lovable AI Gateway
LOVABLE_API_KEY=your_lovable_api_key

# WhatsApp Integration (optional)
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
