# Copy this file to `.env` and fill in real values before running locally.

# --- Backend (client-side, safe to expose) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Backend (server-side only, never expose) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Owner dashboard ---
# Random string (32+ chars) used to sign the owner session cookie.
OWNER_SESSION_SECRET=
OWNER_EMAIL=
# Answers used by /owner-forgot-password
SECURITY_ANSWER_1=
SECURITY_ANSWER_2=

# --- AI chat bot ---
# Required for /api/chat. Provided automatically on Lovable; set manually elsewhere.
LOVABLE_API_KEY=
